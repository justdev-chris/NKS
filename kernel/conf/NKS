# NKS Kernel Configuration
# FreeBSD 14.x - Stripped for NyaaKitStation

include GENERIC
ident NKS

# ---- CPU ----
cpu HAMMER

# ---- Platform ----
machine amd64

# ---- Bus ----
device      acpi
device      pci
device      isa

# ---- Console & Framebuffer ----
device      vt
device      fb
options     VESA
options     SC_PIXEL_MODE

# ---- USB (for keyboard & storage) ----
device      usb
device      xhci
device      ehci
device      ohci
device      uhci
device      uhid
device      ukbd
device      umass

# ---- Storage (to boot) ----
device      ahci
device      ata
device      da
device      cd

# ---- Audio ----
device      sound
device      snd_hda
device      snd_ich

# ---- Networking ----
# Disable ALL networking (Ethernet, WiFi, etc.)
nooptions   INET6
nooptions   SCTP
nooptions   IPSEC
nodevice    ether
nodevice    re
nodevice    em
nodevice    ix
nodevice    igb
nodevice    wlan
nodevice    wpi
nodevice    iwn
nodevice    ral
nodevice    ath
nodevice    ath_hal
nodevice    ath_pci

# ---- Filesystems ----
options     UFS_ACL
options     UFS_DIRHASH
options     UFS_GJOURNAL
options     MSDOSFS
options     CD9660
options     PROCFS
options     PSEUDOFS

# ---- Misc (remove bloat) ----
nooptions   TCP_OFFLOAD
nooptions   USB_DEBUG

# ---- Debugging (remove) ----
nooptions   INVARIANTS
nooptions   INVARIANT_SUPPORT
nooptions   WITNESS
nooptions   WITNESS_SKIPSPIN
nooptions   DEBUG
nooptions   KDB
nooptions   DDB
nooptions   GDB
nooptions   ALT_BREAK_TO_DEBUGGER

# ---- Boot ----
options     ROOTDEVNAME=\"ufs:da0s2a\"
