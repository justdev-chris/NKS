#
# NKS -- NyaaKitStation custom kernel
#
machine		amd64
cpu		HAMMER
ident		NKS

# Bus support
device		acpi
device		pci
device		isa

# Console & Framebuffer
device		vt
device		fb
options		VESA
options		SC_PIXEL_MODE

# USB (keyboard & storage)
device		usb
device		xhci
device		ehci
device		ohci
device		uhci
device		uhid
device		ukbd
device		umass

# Storage (CAM is required for da/cd)
device		cam
device		da
device		cd
device		pass
device		ata
device		ahci

# Audio
device		sound
device		snd_hda
device		snd_ich

# NO NETWORKING
nooptions	INET
nooptions	INET6
nooptions	SCTP
nooptions	IPSEC
nooptions	TCP_OFFLOAD
nodevice	ether
nodevice	re
nodevice	em
nodevice	ix
nodevice	igb
nodevice	igc
nodevice	wlan
nodevice	wpi
nodevice	iwn
nodevice	ral
nodevice	ath
nodevice	ath_hal
nodevice	ath_pci

# Filesystems
options		UFS_ACL
options		UFS_DIRHASH
options		UFS_GJOURNAL
options		MSDOSFS
options		CD9660
options		PROCFS
options		PSEUDOFS

# Misc
nooptions	USB_DEBUG

# Debugging (remove for smaller kernel)
nooptions	INVARIANTS
nooptions	INVARIANT_SUPPORT
nooptions	WITNESS
nooptions	WITNESS_SKIPSPIN
nooptions	DEBUG
nooptions	KDB
nooptions	DDB
nooptions	GDB
nooptions	ALT_BREAK_TO_DEBUGGER

# Boot
options		ROOTDEVNAME=\"ufs:da0s2a\"
